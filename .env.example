# Copy to .env.local. Every variable is optional: with none set, Speakara runs in guest mode
# (progress saved in the browser) with the scripted tutor.

# --- Supabase (accounts, synced progress, leagues, friends) ---
# Project URL and the publishable (or legacy anon) key. These are safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI tutor (server-side only; never prefix these with NEXT_PUBLIC_) ---
# AI_PROVIDER: "anthropic" or "openai-compatible". Leave empty to auto-detect from the keys below.
AI_PROVIDER=
# Anthropic
ANTHROPIC_API_KEY=
# Any OpenAI-compatible chat-completions endpoint (self-hosted or commercial)
AI_BASE_URL=
AI_API_KEY=
# Model id for the tutor. Defaults to a small, inexpensive Anthropic model when ANTHROPIC_API_KEY is set.
AI_TUTOR_MODEL=
