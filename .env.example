# Copy to .env.local. Every variable is optional: with none set, Speakara runs in guest mode
# (progress saved in the browser) with the scripted tutor and the browser's own voices.

# --- Supabase: accounts, synced progress, leagues, friends, admin ---
# Project URL and the publishable (or legacy anon) key. Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Progress signing (server-side only; REQUIRED when Supabase is configured) ---
# /api/progress re-grades every session and signs the result with this secret; the database verifies the
# signature before changing XP, gems, streaks or completions. It must equal the value stored in the database:
#   insert into private.app_secrets (name, value) values ('progress_hmac', '<same value>')
#     on conflict (name) do update set value = excluded.value;
# Generate one with:  openssl rand -hex 32      Never prefix it with NEXT_PUBLIC_.
PROGRESS_SIGNING_SECRET=

# --- AI tutor (server-side only) ---
# AI_PROVIDER: "anthropic" or "openai-compatible". Leave empty to auto-detect from the keys below.
# Without a provider the tutor runs scripted scenes for all nine scenarios.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Any OpenAI-compatible chat-completions endpoint (self-hosted or commercial)
AI_BASE_URL=
AI_API_KEY=
# Model id for the tutor and explanations. Defaults to a small Anthropic model when ANTHROPIC_API_KEY is set.
AI_TUTOR_MODEL=

# --- Server text-to-speech (optional; server-side only) ---
# Any OpenAI-compatible /audio/speech endpoint. Audio is cached for a year per sentence.
# Set NEXT_PUBLIC_TTS_REMOTE=1 to make the app use it instead of the browser's voices.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
NEXT_PUBLIC_TTS_REMOTE=
