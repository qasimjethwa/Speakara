# Copy to .env.local for local runs. In LiveKit Cloud, set these as agent secrets. Never commit real values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Gemini Developer API key (the plugin reads GOOGLE_API_KEY; GEMINI_API_KEY is accepted too)
GEMINI_API_KEY=
ANAM_API_KEY=
# Shared with the Next.js app (Vercel) so the worker and the app can trust each other
LIVE_WORKER_SECRET=
# Where the Speakara app is served, e.g. https://speakara.vercel.app
SPEAKARA_API_URL=
# Optional
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_REPORT_MODEL=gemini-2.5-flash
# Only for Vercel preview deployments protected by Vercel Authentication
VERCEL_AUTOMATION_BYPASS_SECRET=
